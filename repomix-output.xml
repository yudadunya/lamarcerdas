              {gaps.length > 0 && (
                <div style={{ marginTop: 10 }}>
                  <div style={{ color: 'rgba(255,255,255,0.22)', fontSize: '0.67rem', letterSpacing: '0.8px', marginBottom: 8 }}>YANG MASIH PERLU DILATIH:</div>
