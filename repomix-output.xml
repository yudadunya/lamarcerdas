:root {
  /* Verneks brand palette: blue-purple, calm, and clear */
  --wa-green: #22A8F2;
  --wa-green-dark: #1674C9;
  --wa-green-deeper: #113E80;
  --wa-teal: #6745E8;
  --wa-bg: #F5F8FE;
  --wa-chat-bg: #EEF3FC;
  --wa-header: #08111F;
  --wa-header-light: #142A4E;
  --wa-bubble-out: #E8E0FF;
  --wa-bubble-in: #FFFFFF;
  --wa-bubble-out-text: #111;
  --wa-dark: #111E34;
  --wa-gray: #657386;
  --wa-gray-light: #F1F5FB;
  --wa-border: #DDE6F3;
  --wa-tick: #22A8F2;
  --wa-read: #22A8F2;
  --wa-panel: #FFFFFF;
  --wa-input-bg: #FFFFFF;
  --wa-hover: #F5F6F6;
  --wa-selected: #E9F0FF;
  --wa-bottom-nav: #FFFFFF;
  --wa-icon: #54656F;
  --wa-active-tab: #6745E8;
  --wa-red: #D6455D;

  /* Shared aliases for older components */
  --green: #22A8F2;
  --green-light: #6745E8;
  --green-dark: #1674C9;
  --cream: #F5F8FE;
  --dark: #111E34;
  --gray: #657386;
  --gray-light: #F1F5FB;
  --border: #DDE6F3;
  --font-display: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-body: 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
  background: var(--wa-bg);
  color: var(--wa-dark);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  max-width: 480px;
  margin: 0 auto;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  cursor: pointer;
  font-family: var(--font-body);
  border: none;
  background: none;
}

input, textarea {
  font-family: var(--font-body);
}

/* WA-style scrollbar */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #ccc; border-radius: 2px; }

/* ============================================
   GLOBAL WA COMPONENTS
   ============================================ */

/* Header WA */
.wa-header {
  background: var(--wa-header);
  color: #fff;
  padding: 10px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  position: sticky;
  top: 0;
  z-index: 100;
  min-height: 56px;
}

.wa-header-title {
  font-size: 1.1rem;
  font-weight: 600;
  flex: 1;
}

.wa-header-subtitle {
  font-size: 0.75rem;
  opacity: 0.8;
  font-weight: 400;
}

.wa-header-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--wa-green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  flex-shrink: 0;
}

.wa-header-back {
  color: #fff;
  font-size: 1.3rem;
  line-height: 1;
  padding: 4px;
  cursor: pointer;
  background: none;
  border: none;
}

/* Bottom Navigation */
.wa-bottom-nav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 480px;
  background: var(--wa-bottom-nav);
  border-top: 1px solid var(--wa-border);
  display: flex;
  padding: 8px 0;
  z-index: 200;
  box-shadow: 0 -1px 8px rgba(0,0,0,0.08);
}

.wa-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 4px 8px;
  color: var(--wa-gray);
  font-size: 0.65rem;
  font-weight: 500;
  cursor: pointer;
  transition: color 0.15s;
  text-decoration: none;
}

.wa-tab.active {
  color: var(--wa-active-tab);
}

.wa-tab-icon {
  font-size: 1.3rem;
