        .maybeSingle()
      
      if (error) throw error
      return data
    } catch (error) {
      console.error('careerProfileRepository.findByUserId:', error)
      return null
    }
  },

  /**
   * Upsert career profile
   * @param {Object} profileData 
   * @returns {Promise<Object|null>}
   */
