    }
  }
}

/**
 * Chat History Repository
 */
export const chatHistoryRepository = {
  /**
   * Get chat history for user
   * @param {string} userId 
   * @param {number} limit 
   * @returns {Promise<Array>}
   */
  async findByUserId(userId, limit = 50) {
    try {
      const { data, error } = await supabase
        .from('chat_history')
        .select('*')
        .eq('user_id', userId)
        .order('created_at', { ascending: false })
        .limit(limit)
      
      if (error) throw error
      return data || []
    } catch (error) {
      console.error('chatHistoryRepository.findByUserId:', error)
      return []
    }
  },

  /**
   * Save chat message
   * @param {Object} messageData 
   * @returns {Promise<Object|null>}
   */
  async create(messageData) {
    try {
      const { data, error } = await supabase
        .from('chat_history')
        .insert([messageData])
        .select()
        .single()
      
      if (error) throw error
      return data
    } catch (error) {
      console.error('chatHistoryRepository.create:', error)
      return null
    }
  },

  /**
   * Delete chat history for user (for GDPR compliance)
   * @param {string} userId 
   * @returns {Promise<boolean>}
   */
  async deleteByUserId(userId) {
    try {
      const { error } = await supabase
        .from('chat_history')
        .delete()
        .eq('user_id', userId)
      
      if (error) throw error
      return true
    } catch (error) {
      console.error('chatHistoryRepository.deleteByUserId:', error)
      return false
    }
  }
}

