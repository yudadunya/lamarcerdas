                        <span style={{ fontSize: '0.9rem' }}>{g.emoji}</span>
                        <span style={{ color: isTop ? '#fff' : 'rgba(255,255,255,0.7)', fontWeight: isTop ? 700 : 500, fontSize: '0.82rem' }}>{g.label}</span>
                        {isTop && (
