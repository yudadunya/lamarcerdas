  label: { color: 'rgba(255,255,255,0.35)', fontSize: '0.65rem', letterSpacing: '1px', marginBottom: 4 },
  sectionTitle: { color: '#fff', fontWeight: 700, fontSize: '0.88rem', marginBottom: 12 },
